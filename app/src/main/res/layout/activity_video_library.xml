<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="?android:colorBackground"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back Button -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← رجوع"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/text_light"
            android:background="@drawable/rounded_button"
            android:layout_gravity="start"
            android:layout_marginBottom="16dp" />

        <!-- Page Title -->

        <TextView
            android:id="@+id/tvLibraryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مكتبة الفيديوهات"
            android:textSize="28sp"
            android:textStyle="bold"

            android:textColor="?android:textColorPrimary"

            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Page Subtitle -->

        <TextView
            android:id="@+id/tvLibrarySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فيديوهات تعليمية قصيرة تساعد الطفل على الحفظ بطريقة ممتعة"
            android:textSize="16sp"

            android:textColor="?android:textColorSecondary"

            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Video 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvVideoTitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعلم سورة الفاتحة"
                android:textSize="20sp"
                android:textStyle="bold"

                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/tvVideoDesc1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شرح قصير ومبسط للأطفال"
                android:textSize="14sp"

                android:textColor="?android:textColorSecondary"

                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnVideo1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تشغيل الفيديو" />
        </LinearLayout>

        <!-- Video 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvVideoTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعلم سورة الإخلاص"
                android:textSize="20sp"
                android:textStyle="bold"

                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/tvVideoDesc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تحفيظ سهل للأطفال"
                android:textSize="14sp"

                android:textColor="?android:textColorSecondary"

                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnVideo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تشغيل الفيديو" />
        </LinearLayout>

        <!-- Video 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvVideoTitle3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعلم سورة الفلق"
                android:textSize="20sp"
                android:textStyle="bold"

                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/tvVideoDesc3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تكرار ممتع للأطفال"
                android:textSize="14sp"

                android:textColor="?android:textColorSecondary"

                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnVideo3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تشغيل الفيديو" />
        </LinearLayout>

        <!-- Video 4 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvVideoTitle4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعلم سورة الناس"
                android:textSize="20sp"
                android:textStyle="bold"

                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/tvVideoDesc4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعليم وتحفيظ للأطفال"
                android:textSize="14sp"

                android:textColor="?android:textColorSecondary"

                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnVideo4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تشغيل الفيديو" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>