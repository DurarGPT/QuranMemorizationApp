<?xml version="1.0" encoding="utf-8"?>

<!-- Third screen: displays Mushaf page, current ayah, and playback controls -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Back button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← رجوع"
            android:textAllCaps="false"
            android:textColor="@color/text_light"
            android:background="@drawable/rounded_button"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"/>

        <!-- Page title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التحكم بالحفظ"
            android:textColor="@color/teal_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Last saved progress -->
        <TextView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آخر موضع محفوظ: لا يوجد تقدم محفوظ"
            android:textColor="@color/purple_main"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Mushaf page image -->
        <ImageView
            android:id="@+id/imgPage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:adjustViewBounds="true"
            android:background="@drawable/card_background"
            android:contentDescription="صورة صفحة المصحف"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:layout_marginBottom="4dp"/>

        <!-- Page information -->
        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="صفحة المصحف: -"
            android:textColor="@color/text_gray"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="14dp"/>

        <!-- Ayah display -->
        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اضغطي تشغيل للبدء"
            android:textSize="22sp"
            android:textColor="@color/teal_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:textDirection="rtl"
            android:textAlignment="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="14dp"/>

        <!-- Play current ayah/repetition -->
        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تشغيل"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@color/text_light"
            android:background="@drawable/rounded_button"
            android:layout_marginTop="6dp"/>

        <!-- Pause audio/repetition -->
        <Button
            android:id="@+id/btnPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إيقاف مؤقت"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@color/text_light"
            android:background="@drawable/rounded_button"
            android:layout_marginTop="6dp"/>

        <!-- Replay same ayah -->
        <Button
            android:id="@+id/btnReplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعادة تشغيل الآية"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@color/text_light"
            android:background="@drawable/rounded_button"
            android:layout_marginTop="6dp"/>

        <!-- Go back to previous ayah -->
        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الآية السابقة"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@color/text_light"
            android:background="@drawable/rounded_button"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

</ScrollView>