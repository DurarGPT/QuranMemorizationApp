<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/text_light"
            android:background="@drawable/rounded_button"
            android:layout_gravity="start"
            android:layout_marginBottom="18dp"/>

        <ImageView
            android:id="@+id/imgAboutLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/qiraati_logo"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/tvAboutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About Qiraati"
            android:textColor="@color/teal_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvAboutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qiraati is a simple and child-friendly Quran memorization app designed to help children memorize Quran verses in a calming and enjoyable way."
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:lineSpacingExtra="6dp"
                android:gravity="center"
                android:layout_marginBottom="18dp"/>

            <TextView
                android:id="@+id/tvFeaturesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Features"
                android:textColor="@color/purple_main"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvFeaturesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Ayah repetition&#10;• Easy memorization controls&#10;• Dark mode support&#10;• Arabic and English support&#10;• Child-friendly design"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:lineSpacingExtra="8dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>