<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Main container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Back button -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:background="@drawable/rounded_button" />

            <!-- Space pushes menu button right -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Menu button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_more"
                android:background="@android:color/transparent"
                app:tint="@color/text_dark"
                android:contentDescription="Menu" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvSecondTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 Memorization Control"
            android:textColor="@color/teal_dark"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSecondSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose the surah, ayah range, and repeat count"
            android:textColor="@color/text_gray"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="22dp" />

        <!-- Main card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:padding="22dp">

            <!-- Surah label -->
            <TextView
                android:id="@+id/tvSurahLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Surah"
                android:textColor="@color/text_dark"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Searchable Surah picker -->
            <AutoCompleteTextView
                android:id="@+id/actvSurah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search Surah"
                android:singleLine="true"
                android:completionThreshold="0"
                android:inputType="text"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZابتثجحخدذرزسشصضطظعغفقكلمنهويىءآأإؤئاة ٠١٢٣٤٥٦٧٨٩0123456789."
                android:layout_marginBottom="16dp" />

            <!-- From Ayah input -->
            <EditText
                android:id="@+id/etFromAyah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="From Ayah"
                android:inputType="text"
                android:digits="0123456789٠١٢٣٤٥٦٧٨٩"
                android:layout_marginBottom="12dp" />

            <!-- To Ayah input -->
            <EditText
                android:id="@+id/etToAyah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="To Ayah"
                android:inputType="text"
                android:digits="0123456789٠١٢٣٤٥٦٧٨٩"
                android:layout_marginBottom="18dp" />

            <!-- Repeat label -->
            <TextView
                android:id="@+id/tvRepeatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repeat Count"
                android:textColor="@color/text_dark"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Repeat picker -->
            <NumberPicker
                android:id="@+id/npRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

            <!-- Status text -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to start"
                android:textColor="@color/purple_main"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <!-- Start button -->
            <Button
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶ Play"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textColor="@color/text_light"
                android:background="@drawable/rounded_button" />

            <Button
                android:id="@+id/btnContinueProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Continue Last Progress"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textColor="@color/text_light"
                android:background="@drawable/rounded_button" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>